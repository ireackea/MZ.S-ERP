POSTGRES_DB=feed_factory_db
POSTGRES_USER=feedfactory
POSTGRES_PASSWORD=<local-postgres-password>
DATABASE_URL=<postgres-connection-string-for-runtime>
DATABASE_DIRECT_URL=<postgres-connection-string-for-direct-access>
JWT_SECRET=<min-32-char-random-secret>
BACKUP_ENCRYPTION_SECRET=<min-32-char-random-secret>
# FC-QA-002 — docker-compose.yml:35 requires this with the `:?` form, so
# `docker compose config` aborts without it, and the restore endpoint answers 401
# for every caller. It was missing here, which meant copying this file to `.env`
# could never have produced a runnable stack.
BACKUP_RESTORE_PIN=<restore-pin>
# B15-0 — the memory one backup is allowed to need. The dump ceiling is derived from
# it (a measured 13x the dump size), so this number is what decides how large a
# database can be copied at all. 3 GiB allows a ~236 MiB dump. Raising it without
# raising BACKUP_CONTAINER_MEMORY and the heap ceiling buys an OOM instead of a
# backup.
BACKUP_MAX_PEAK_BYTES=3221225472
BACKUP_CONTAINER_MEMORY=4g
NODE_OPTIONS=--enable-source-maps --max-old-space-size=3072
# B15-2 — which format new archives are written in.
#   2 = the historical JSON envelope. Every archive written before this existed.
#   3 = the streaming container: the dump is never base64 and never held in memory,
#       so the archive is 1.00x the dump instead of 1.78x and the 288 MiB ceiling
#       imposed by V8's string limit no longer applies.
# Both formats are readable and restorable by this build, so this can be changed at any
# time and old archives keep working. 3 is the default since its round trip was measured
# end to end; set 2 to keep writing the base64 envelope format.
BACKUP_ARCHIVE_VERSION=3
SYSTEM_RESET_TOKEN=<min-16-char-random-token>
METRICS_AUTH_TOKEN=<min-32-char-random-secret>
PORT=3001
ADMIN_PASSWORD=<strong-admin-password>
# FC-ITEM-IMPORT — the bulk import limits. These must stay in step with
# JSON_BODY_LIMIT below and with `client_max_body_size` in both nginx configs;
# raising one and not the others is how a 15,000-row import turns into a 413.
MAX_BULK_IMPORT_ROWS=15000
BULK_IMPORT_BATCH_SIZE=250
# The parsed JSON body. A 15,000-row Arabic payload measures about 4 MB, so
# anything below 5m rejects a legitimate import.
JSON_BODY_LIMIT=10mb
# Number of reverse proxies in front of the backend. 0 means there is none, so
# X-Forwarded-For is attacker-controlled and must be ignored. Set to 1 only where
# nginx actually sits in front (docker-compose.prod.yml, the `nginx` profile).
TRUSTED_PROXY_HOPS=0
# FC-SEC-006 — the base URL invitation links are built from. Must match the port
# the frontend is actually served on (4173 in the production compose stack).
APP_BASE_URL=http://localhost:4173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000
ALLOW_CODESPACES_ORIGINS=false
VITE_BACKEND_ORIGIN=http://localhost:3001
VITE_API_URL=http://localhost:3001
NODE_ENV=development
