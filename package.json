{
  "name": "feedfactory-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run frontend:dev",
    "postinstall": "node scripts/postinstall.mjs || echo 'Postinstall skipped - run manually'",
    "audit:surgical": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1",
    "audit:surgical:static": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1 -StaticOnly",
    "audit:surgical:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1 -RuntimeOnly",
    "test:audit": "node scripts/audit/tests/analyzers.test.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "validate:phase1": "node scripts/validation-phase1.mjs",
    "validate:phase3": "node scripts/validation-phase3.mjs",
    "validate:all": "npm run validate:phase1 && npm run validate:phase3",
    "build": "npm run check:encoding && npm run frontend:build",
    "build:full": "npm run check:encoding && npm run frontend:build && npm run backend:build",
    "build:prod": "npm run check:encoding && npm run frontend:build && npm run backend:build",
    "preview": "npm run frontend:preview",
    "frontend:dev": "npm run dev --workspace=frontend --",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:preview": "npm run preview --workspace=frontend --",
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:start": "npm run start:prod --workspace=backend",
    "start:prod": "node scripts/run-parallel.mjs \"[{\\\"label\\\":\\\"BACKEND\\\",\\\"command\\\":\\\"npm run backend:start\\\"},{\\\"label\\\":\\\"FRONTEND\\\",\\\"command\\\":\\\"npm run preview --workspace=frontend -- --host 0.0.0.0 --port 4173\\\"}]\"",
    "start:prod-full": "npm run prisma:migrate:prod && npm run build:full && npm run start:prod",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=backend",
    "prisma:migrate:prod": "npm run prisma:migrate:prod --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "health-check": "node scripts/health-check.mjs",
    "monitor:check": "node scripts/monitor-check.mjs",
    "test:e2e:login": "npm exec vitest -- --run tests/e2e/login.spec.ts",
    "test:e2e:settings": "npm exec vitest -- --run tests/e2e/settings-regression.spec.ts",
    "test:e2e:full": "npm exec vitest -- --run tests/e2e/full-system.spec.ts",
    "verify:visual:load": "npm run build:full && npm run monitor:check && npm run test:e2e:login",
    "verify:absolute:proof": "npm run build:full && npm run monitor:check && npm run test:e2e:login",
    "deploy:prod": "docker compose up -d --build && npm run health-check && npm run monitor:check",
    "test": "npm run test --workspace=frontend",
    "dev:full": "node scripts/run-parallel.mjs \"[{\\\"label\\\":\\\"BACKEND\\\",\\\"command\\\":\\\"npm run backend:dev\\\"},{\\\"label\\\":\\\"FRONTEND\\\",\\\"command\\\":\\\"npm run frontend:dev\\\"}]\"",
    "start:backend": "npm run backend:dev",
    "start:frontend": "npm run frontend:dev",
    "db:sync": "npm run prisma:generate && npm run prisma:migrate:dev"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@prisma/client": "^7.7.0",
    "concurrently": "^9.2.1",
    "prisma": "^7.7.0"
  }
}
