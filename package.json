{
  "name": "feedfactory-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run frontend:dev",
    "postinstall": "node scripts/postinstall.mjs || echo 'Postinstall skipped - run manually'",
    "audit:surgical": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1",
    "audit:surgical:static": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1 -StaticOnly",
    "audit:surgical:runtime": "powershell -ExecutionPolicy Bypass -File .\\scripts\\audit\\Invoke-SurgicalAudit.ps1 -RuntimeOnly",
    "test:audit": "node --test scripts/audit/tests/*.test.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "validate:phase1": "node scripts/validation-phase1.mjs",
    "validate:phase3": "node scripts/validation-phase3.mjs",
    "validate:all": "npm run validate:phase1 && npm run validate:phase3",
    "build": "npm run check:encoding && npm run frontend:build",
    "build:full": "npm run check:encoding && npm run frontend:build && npm run backend:build",
    "build:prod": "npm run check:encoding && npm run frontend:build && npm run backend:build",
    "preview": "npm run frontend:preview",
    "frontend:dev": "npm run dev --workspace=frontend --",
    "frontend:build": "npm run build --workspace=frontend",
    "frontend:preview": "npm run preview --workspace=frontend --",
    "backend:dev": "npm run start:dev --workspace=backend",
    "backend:build": "npm run build --workspace=backend",
    "backend:start": "npm run start:prod --workspace=backend",
    "start:prod": "node scripts/run-parallel.mjs \"[{\\\"label\\\":\\\"BACKEND\\\",\\\"command\\\":\\\"npm run backend:start\\\"},{\\\"label\\\":\\\"FRONTEND\\\",\\\"command\\\":\\\"npm run preview --workspace=frontend -- --host 0.0.0.0 --port 4173\\\"}]\"",
    "start:prod-full": "npm run prisma:migrate:prod && npm run build:full && npm run start:prod",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate:dev": "npm run prisma:migrate:dev --workspace=backend",
    "prisma:migrate:prod": "npm run prisma:migrate:prod --workspace=backend",
    "prisma:seed": "npm run prisma:seed --workspace=backend",
    "health-check": "node scripts/health-check.mjs",
    "monitor:check": "node scripts/monitor-check.mjs",
    "test:e2e:login": "npm exec vitest -- --run tests/e2e/login.spec.ts",
    "test:e2e:settings": "npm exec vitest -- --run tests/e2e/settings-regression.spec.ts",
    "test:e2e:full": "npm exec vitest -- --run tests/e2e/full-system.spec.ts",
    "test:e2e:phase1": "npm exec vitest -- --run tests/e2e/phase1-security.spec.ts",
    "test:e2e:inventory": "npm exec vitest -- --run tests/e2e/inventory-boundary.spec.ts",
    "test:e2e:stock-adjustment": "npm exec vitest -- --run tests/e2e/stock-adjustment.spec.ts",
    "test:e2e:data-003": "npm exec vitest -- --run tests/e2e/data-003-domains.spec.ts",
    "test:e2e:items-order-profile": "npm exec vitest -- --run tests/e2e/items-order-profile.spec.ts",
    "test:e2e:items-order-import": "npm exec vitest -- --run tests/e2e/items-order-import.spec.ts",
    "test:e2e:items-order": "npm exec vitest -- --run tests/e2e/items-order.spec.ts",
    "test:e2e:items-api": "npm exec vitest -- --run tests/e2e/items-api.spec.ts",
    "test:e2e:offline-queue": "npm exec vitest -- --run tests/e2e/offline-queue.spec.ts",
    "test:e2e:scope": "npm exec vitest -- --run tests/e2e/scope-isolation.spec.ts",
    "test:backend:time": "npm exec vitest -- --run backend/src/common/time/time.service.test.ts",
    "test:backend:scope": "npm exec vitest -- --run backend/src/common/scope.test.ts",
    "test:backend:permissions": "npm exec vitest -- --run backend/src/auth/permission-catalog.test.ts",
    "test:backend:audit": "npm exec vitest -- --run backend/src/audit/audit-redaction.test.ts",
    "test:backend:attachments": "npm exec vitest -- --run backend/src/item/attachment-safety.test.ts",
    "test:backend:reports": "npm exec vitest -- --run backend/src/common/operation-type.test.ts",
    "test:backend:pgdump": "npm exec vitest -- --run backend/src/backup/pg-dump.test.ts",
    "test:e2e:reset-success": "npm exec vitest -- --run tests/e2e/reset-success.spec.ts",
    "test:e2e:backup": "npm exec vitest -- --run tests/e2e/ops-001-backup.spec.ts",
    "test:e2e:audit": "npm exec vitest -- --run tests/e2e/audit-durability.spec.ts",
    "test:e2e:rbac": "npm exec vitest -- --run tests/e2e/rbac-contract.spec.ts",
    "test:e2e:attachments": "npm exec vitest -- --run tests/e2e/item-attachments.spec.ts",
    "test:e2e:reports": "npm exec vitest -- --run tests/e2e/report-contract.spec.ts",
    "verify:visual:load": "npm run build:full && npm run monitor:check && npm run test:e2e:login",
    "verify:absolute:proof": "npm run build:full && npm run monitor:check && npm run test:e2e:login",
    "deploy:prod": "docker compose up -d --build && npm run health-check && npm run monitor:check",
    "test": "npm run test --workspace=frontend",
    "dev:full": "node scripts/run-parallel.mjs \"[{\\\"label\\\":\\\"BACKEND\\\",\\\"command\\\":\\\"npm run backend:dev\\\"},{\\\"label\\\":\\\"FRONTEND\\\",\\\"command\\\":\\\"npm run frontend:dev\\\"}]\"",
    "start:backend": "npm run backend:dev",
    "start:frontend": "npm run frontend:dev",
    "db:sync": "npm run prisma:generate && npm run prisma:migrate:dev",
    "test:backend": "npm run test --workspace=backend -- --run",
    "test:unit": "npm run test:backend && npm run test --workspace=frontend -- --run",
    "typecheck": "npm exec tsc -- --noEmit -p backend/tsconfig.json && npm exec tsc -- --noEmit -p frontend/tsconfig.json",
    "prisma:validate": "npm run prisma:validate --workspace=backend",
    "ci:verify": "npm run check:encoding && npm run prisma:generate && npm run prisma:validate && npm run typecheck && npm run test:audit && npm run test:unit && npm run build:full && docker compose config --quiet",
    "ci:runtime": "node scripts/ci-runtime-gate.mjs",
    "ci:node": "22",
    "test:e2e:data-001": "npm exec vitest -- --run tests/e2e/data-001-decimal.spec.ts",
    "test:qa:http": "node scripts/qa/qa-002-runtime-proof.mjs",
    "test:qa:browser": "npm exec vitest -- --run tests/e2e/phase3-visual-proof.spec.ts",
    "test:qa:offline": "npm exec vitest -- --run tests/e2e/qa-002-offline.spec.ts tests/e2e/offline-queue.spec.ts",
    "test:qa:runtime": "npm run test:qa:http && npm run test:qa:browser && npm run test:qa:offline",
    "test:e2e:deficit": "npm exec vitest -- --run tests/e2e/def-001-stock-deficit.spec.ts",
    "test:e2e:deficit-ui": "npm exec vitest -- --run tests/e2e/def-001-deficit-ui.spec.ts"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@prisma/client": "^7.7.0",
    "concurrently": "^9.2.1",
    "prisma": "^7.7.0"
  }
}
