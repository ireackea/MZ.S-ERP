// ENTERPRISE FIX: Phase 4 Audit Logging + Soft Delete Backend + Pagination - Archive Only - 2026-03-27
// ENTERPRISE FIX: Phase 1 – PostgreSQL Pivot + Zustand Single Source of Truth - 2026-03-13
// ENTERPRISE FIX: Phase 0.2 – Full Runtime Docker Proof - 2026-03-13
// ENTERPRISE FIX: Phase 0 – التنظيف الأساسي والأمان الحرج - 2026-03-13
// Audit Logs moved to Prisma | JWT Cookie-only | Lazy Loading | No JSON fallback
// Prisma Schema - Database Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  invitations Invitation[]

  @@map("roles")
}

model User {
  id                     String           @id @default(uuid())
  username               String           @unique
  email                  String?          @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  isActive               Boolean          @default(true)
  // FC-SEC-012 — `isActive` used to carry two meanings at once. Locking an
  // account set isActive=false, and so did deactivating one, so a deliberate
  // deactivation was indistinguishable from a security lock: the user list
  // labelled every one of them "locked", and a deactivated account matched
  // neither the `active` nor the `locked` filter, which meant it could not be
  // found at all. `isLocked` is the security state; `isActive` is the employment
  // state; `lockoutUntil` remains the timed-failure lock.
  isLocked               Boolean          @default(false)
  failedAttempts         Int              @default(0)
  lockoutUntil           DateTime?
  // FC-SEC-010 — the superadmin password used to be re-written from
  // ADMIN_PASSWORD on every boot whenever the stored hash differed, so it could
  // never be rotated away from the value in .env. `passwordSetByUser` closes
  // that: the env value seeds the account once, and after the operator chooses
  // their own password the env value is never written again.
  passwordSetByUser      Boolean          @default(false)
  // Set when the current password is temporary — an admin reset, or the very
  // first seed — so the UI can force a change before anything else is reachable.
  mustChangePassword     Boolean          @default(false)
  theme                  String           @default("classic")
  roleId                 String
  role                   Role             @relation(fields: [roleId], references: [id])
  updatedAt              DateTime         @updatedAt
  createdAt              DateTime         @default(now())
  createdOpeningBalances OpeningBalance[] @relation("BalanceCreator")
  
  // Phase 2: Multi-login and Email Invites
  googleId               String?          @unique
  inviteToken            String?          @unique
  inviteExpires          DateTime?
  isEmailConfirmed       Boolean          @default(false)
  sentInvitations        Invitation[]     @relation("InvitationSender")
  updatedSystemSettings   SystemSetting[]
  acceptedInvitation     Invitation?      @relation("InvitationRecipient")
  auditLogs              AuditLog[]       @relation("AuditActor")
  activeSessions         ActiveSession[]
  idempotencyRecords     IdempotencyRecord[]
  createdPartners        Partner[]         @relation("PartnerCreator")
  createdOrders          Order[]           @relation("OrderCreator")
  createdStocktaking     StocktakingSession[] @relation("StocktakingCreator")
  stocktakingCounts      StocktakingCount[] @relation("StocktakingCounter")

  @@map("users")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?  @map("actorId")
  action         String   // CREATE / UPDATE / ARCHIVE / DELETE / RESTORE
  entityType     String   // Item / Transaction / User / etc.
  entityId       String
  details        String?  @map("message")
  timestamp      DateTime @default(now())
  ipAddress      String?
  metadata       String?
  actorUsername  String
  actorRole      String
  targetUserId   String?
  targetResource String?
  status         String   @default("SUCCESS")
  actor          User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([status])
  @@index([timestamp])
  // Gate 2.8 - `targetUserId` was unindexed while being the only filter
  // GET /users/:id/audit uses, and it is written on every user-management action.
  @@index([targetUserId])
  // Gate 2.9 — declared so the diff engine stops proposing to drop them. The
  // audit list orders by timestamp descending on every page; the ascending index
  // above cannot serve that without a sort, and the free-text search is five
  // `ILIKE '%…%'` predicates that need the trigram operator class.
  //
  // Until these were in the datamodel they were objects Prisma did not own, and
  // the next generated migration would have dropped the index that keeps that
  // search off a sequential scan — silently, because nothing in the migration
  // said "this also removes a search index".
  //
  // `map` is not optional here. Prisma derives an index name from the *field*
  // name, and the searched column is `details`, mapped to `message`. Without it
  // the datamodel would own a differently-named index and still want the live one
  // dropped — the declaration would have fixed nothing.
  @@index([timestamp(sort: Desc)], map: "audit_logs_timestamp_desc_idx")
  @@index([actorUsername(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_actorUsername_trgm_idx")
  @@index([details(ops: raw("gin_trgm_ops"))], type: Gin, map: "audit_logs_message_trgm_idx")
  @@map("audit_logs")
}

model ActiveSession {
  id                String   @id @default(uuid())
  userId            String
  tokenHash         String?  @unique
  expiresAt         DateTime
  deviceInfo        String?  @map("deviceFingerprint")
  isRevoked         Boolean  @default(false)
  username          String
  role              String
  ipAddress         String
  userAgent         String
  createdAt         DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("active_sessions")
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorId     String
  operation   String
  key         String
  // Gate 2.9 — bare `String` means `text`; the column is char(64), which is also
  // what a fixed-width digest should be. Queued as an ALTER TYPE on every
  // generated migration until the datamodel said so.
  requestHash String @db.Char(64)
  response    Json
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  status         String    @default("pending")
  roleId         String
  invitedById    String?
  recipientUserId String?  @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy      User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  recipientUser  User?     @relation("InvitationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@map("invitations")
}

model Item {
  id              Int              @id @default(autoincrement())
  publicId        String?          @unique
  code            String?          @unique
  codeGenerated   Boolean          @default(false)
  barcode         String?
  name            String
  unit            String?
  category        String           @default("غير مصنف")
  minLimit        Decimal          @default(0)
  maxLimit        Decimal          @default(1000)
  orderLimit      Decimal?
  // Gate 2.9 — bare `Decimal` means DECIMAL(65,30), and the column is numeric(12,3).
  // The mismatch made every generated migration carry
  // `ALTER TABLE "Item" ALTER COLUMN "packageWeight" SET DATA TYPE DECIMAL(65,30)`
  // — a rewrite of the main items table under an ACCESS EXCLUSIVE lock, and a
  // silent change of scale from three decimal places to thirty. Declaring what the
  // column has always been removes it without touching a single row.
  packageWeight   Decimal? @db.Decimal(12, 3)
  currentStock    Decimal          @default(0)
  description     String?
  /// The English name. This column did not exist until migration
  /// 20260929110000, even though the DTO, the import template, the client-side
  /// matcher, the payload builder and the exporter all carried the field — so an
  /// operator could type one, watch the request succeed, and find it gone. Nullable
  /// and unindexed: nothing looks an item up by it yet.
  englishName     String?
  imageUrl        String?
  attachments     Json?
  isArchived      Boolean          @default(false)
  archivedAt      DateTime?
  archivedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  updatedBy       String?
  // The catalog order an operator saved with "حفظ ترتيب الأصناف".
  //
  // Nullable rather than non-null with a default, because the migration
  // backfills existing rows and Prisma has no way to express "backfilled"; the
  // application treats null as "sort me after everything explicitly ranked".
  //
  // The high default is what does that work: a row inserted by any path — the
  // create endpoint, the Excel import, bulk sync — lands at the end of the
  // catalog without that path knowing this column exists. A path that had to
  // remember to write a rank would eventually forget, and a forgotten rank
  // would scatter a new item into the middle of the catalog.
  //
  // The default is declared here because 20260928090000 set it in the database
  // and an undeclared default is a default the next `prisma migrate dev` deletes
  // as drift. Declaring it keeps the model and the database in agreement, which
  // is also what makes the value survive a restore: the snapshot restore path
  // re-inserts items with `createMany` and lets every column take its default,
  // so a snapshot taken before this column existed lands the whole catalogue at
  // 1000000 and reproduces, on every restore, the tie-everything bug
  // 20260928110000_normalise_item_sort_order exists to repair. That migration is
  // a one-off and does not re-run.
  sortOrder       Int?              @default(1000000)
  openingBalances OpeningBalance[]
  targetFormulas  Formulation[]    @relation("FormulationTargetItem")
  formulaRows     FormulationItem[] @relation("FormulationIngredientItem")
  // The saved, named orders this item appears in. The relation exists so an item
  // deleted from the catalogue leaves no orphan rank behind in a saved order.
  orderEntries    ItemOrderEntry[]
  transactions    Transaction[]
  orderItems      OrderItem[]
  stocktakingEntries StocktakingEntry[]
  stockDeficits     StockDeficit[]

  @@index([name])
  @@index([code])
  @@index([barcode])
  @@index([isArchived])
  @@index([sortOrder])
  /// The import that last wrote this row, when it was a bulk import. Nullable, and
  /// not indexed on its own: most rows are NULL and most catalogue reads never touch
  /// the column, so an index there would be paid for and never used. The lookup that
  /// matters is "every item of one batch", which the partial index below serves.
  lastImportBatchId String?         @db.Uuid
  lastImportBatch   ItemImportBatch? @relation(fields: [lastImportBatchId], references: [id], onDelete: SetNull)
}

/// One run of the bulk importer, as a thing that can be named and taken back.
model ItemImportBatch {
  id     String @id @default(uuid()) @db.Uuid
  /// What a route takes and what the audit row names. Short by construction: the
  /// audit column it replaced carried one id per created item and overflowed its own
  /// b-tree index at about sixty-five of them.
  publicId String @unique
  sourceFileName String?
  /// Digest of the submitted rows, so re-importing the same file is a detectable
  /// no-op rather than a second attempt at the same catalogue — which is how a
  /// codeless file doubled the catalogue with no message.
  fileHash String?
  /// strict = all or nothing. partial = the rows that validated, in one transaction.
  mode String @default("strict")
  /// succeeded | partial | failed. A string rather than an enum so that adding a
  /// state later is a migration of values rather than a type change on a table that
  /// already holds production rows.
  status String @default("running")
  totalRows Int @default(0)
  createdCount Int @default(0)
  updatedCount Int @default(0)
  skippedCount Int @default(0)
  failedCount Int @default(0)
  durationMs Int?
  /// Deliberately not a foreign key on users: an import's provenance must outlive
  /// the account that performed it, and users are deleted.
  createdBy String?
  actorUsername String?
  startedAt DateTime @default(now())
  finishedAt DateTime?
  /// The whole rejection list, read whole. NOT an indexed text column: the overflow
  /// this table exists beside was caused by putting a variable-length list into one.
  errors Json?
  items Item[]
  rejections ItemImportError[]

  @@index([fileHash])
  @@index([startedAt(sort: Desc)])
}

/// One rejected row, at a grain a client can page through.
model ItemImportError {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  /// The sheet row the client claimed, so the message points at a line the operator
  /// can see. A dense index when the client sent nothing usable.
  rowNumber Int?
  field String?
  message String
  value String?
  batch ItemImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}

/// A saved catalogue order, under a name the operator chose.
///
/// The button "حفظ ترتيب الأصناف" existed for one reason: a catalogue arranged by
/// hand, or imported from a spreadsheet, has to stay arranged. One column on Item
/// can hold that order, but it can hold only one — so the moment somebody wanted
/// a second arrangement, the first had to be overwritten, and there was no way to
/// get it back.
model ItemOrderProfile {
  id        String   @id @default(uuid())
  name      String   @unique
  /// Exactly one profile is active, enforced by a partial unique index rather
  /// than by application code: two active profiles would mean the catalogue has
  /// two orders and no way to say which one a screen is showing.
  isActive  Boolean  @default(false)
  /// How many items were in this order when it was last written. Kept so the
  /// interface can say "3 items are not in this order yet" without a join, and
  /// so a profile that has fallen behind the catalogue is visible rather than
  /// quietly applying an order that no longer covers everything.
  itemCount Int      @default(0)
  note      String?
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ItemOrderEntry[]

  @@index([isActive])
}

/// One item's position inside a saved order.
model ItemOrderEntry {
  profileId String
  itemId    Int
  rank      Int

  profile ItemOrderProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  item    Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([profileId, itemId])
  @@index([profileId, rank])
}

model Partner {
  id           String   @id @default(uuid())
  // Gate 2.9 — the unique index on this column has existed in every deployment
  // since the business-domains migration, which named it `Partner_name_key`.
  // The datamodel declared a plain `@@index`, so the diff engine classified the
  // live unique index as a foreign object: the next generated migration would
  // have replaced it with a non-unique index and let duplicate partner names in.
  //
  // Declared as `@@unique` with an explicit `map` rather than `@unique` on the
  // field, because Prisma derives the name from `@@map("partners")` and would
  // have queued a rename to `partners_name_key`. The block form lets the
  // declaration keep the name the index has actually had since it was created.
  name         String
  type         String
  phone        String
  address      String?
  notes        String?
  createdById  String?
  createdBy    User?    @relation("PartnerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([name], map: "Partner_name_key")
  @@index([type])
  @@map("partners")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  type         String
  partnerId    String
  partner      Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  warehouseId  String?
  date         DateTime
  status       String      @default("pending")
  totalAmount  Decimal?
  notes        String?
  createdById  String?
  createdBy    User?       @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([partnerId])
  @@index([warehouseId])
  @@index([status])
  @@index([date])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity     Decimal
  unit         String?

  @@unique([orderId, itemId])
  @@index([itemId])
  @@map("order_items")
}

model StocktakingSession {
  id             String   @id @default(uuid())
  monthKey       String
  warehouseId    String   @default("default")
  status         String   @default("open")
  closedAt       DateTime?
  closedById     String?
  archivedPdfName String?
  archivedPdfMime String?
  archivedPdfData String?
  createdById    String?
  createdBy      User?    @relation("StocktakingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries        StocktakingEntry[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthKey, warehouseId])
  @@index([status])
  @@map("stocktaking_sessions")
}

model StocktakingEntry {
  id           String   @id @default(uuid())
  sessionId    String
  session      StocktakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actualCount  Decimal?
  notes        String?
  counts       StocktakingCount[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sessionId, itemId])
  @@index([itemId])
  @@map("stocktaking_entries")
}

model StocktakingCount {
  id         String   @id @default(uuid())
  entryId    String
  entry      StocktakingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  value      Decimal
  countedById String?
  countedBy  User?    @relation("StocktakingCounter", fields: [countedById], references: [id], onDelete: SetNull)
  countedAt  DateTime @default(now())

  @@index([entryId])
  @@index([countedById])
  @@map("stocktaking_counts")
}

model Formulation {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  targetItemId       Int
  expectedCostPerTon Decimal?
  notes              String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?
  updatedBy          String?
  targetItem         Item              @relation("FormulationTargetItem", fields: [targetItemId], references: [id], onDelete: Restrict)
  items              FormulationItem[]

  @@index([targetItemId])
  @@index([name])
  @@index([isActive])
  @@map("formulations")
}

model FormulationItem {
  id            String      @id @default(cuid())
  formulationId String
  itemId        Int
  percentage    Decimal
  weightPerTon  Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  formulation   Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  item          Item        @relation("FormulationIngredientItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([formulationId, itemId])
  @@index([itemId])
  @@map("formulation_items")
}

model OpeningBalance {
  id            Int      @id @default(autoincrement())
  itemId        Int
  financialYear Int
  quantity      Decimal
  unitCost      Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  // FC-SEC-011 — this was the one relation in the schema with no onDelete, so
  // it defaulted to Restrict. It never fired only because `createdBy` was never
  // written. The moment the author of an opening balance is recorded — a
  // mandatory fact for a fiscal-year starting position — deleting that user
  // would have started returning a 500 from DELETE /users/:id. SetNull matches
  // every other creator relation in the schema.
  creator User? @relation("BalanceCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([itemId, financialYear])
  @@index([financialYear])
}

model UnloadingRule {
  id                     String   @id @default(cuid())
  ruleName               String   @unique
  allowedDurationMinutes Int
  penaltyRatePerMinute   Decimal
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String?
  updatedBy              String?
  transactions           Transaction[]

  @@index([ruleName])
  @@index([isActive])
  @@map("unloading_rules")
}

/// Gate 2.1 — the server-side home for company settings.
///
/// Key/value rather than one column per setting, so adding a preference does not
/// need a migration. `valueType` carries what a plain TEXT column cannot, and is
/// what the settings screen renders against. `updatedById` uses SetNull, like the
/// opening-balance author: deleting a user must not take the company settings
/// with them.
model SystemSetting {
  key         String   @id
  value       String?
  valueType   String   @default("string")
  category    String   @default("general")
  label       String?
  updatedById String?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([updatedById])
  @@map("system_settings")
}

model ReferenceDataValue {
  id        String   @id @default(uuid())
  kind      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([kind])
  @@index([value])
  @@map("reference_data_values")
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique
  date               DateTime
  itemId             Int
  warehouseId        String?
  warehouseInvoice   String?
  supplierInvoice    String?
  type               String
  quantity           Decimal
  supplierNet        Decimal?
  difference         Decimal?
  packageCount       Decimal?
  weightSlip         String?
  salaryOfWorker     Decimal?
  supplierOrReceiver String
  truckNumber        String?
  trailerNumber      String?
  driverName         String?
  entryTime          String?
  exitTime           String?
  unloadingRuleId    String?
  unloadingDuration  Int?
  delayDuration      Int?
  delayPenalty       Decimal?
  calculatedFine     Decimal?
  notes              String?
  attachmentData     String?
  attachmentName     String?
  attachmentType     String?
  googleDriveLink    String?
  adjustmentReason           String?
  adjustmentSourceReference  String?
  adjustmentDirection        String?
  createdByUserId    String?
  timestamp          BigInt?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unloadingRule UnloadingRule? @relation(fields: [unloadingRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([date])
  @@index([itemId])
  @@index([type])
  @@index([unloadingRuleId])
  @@index([warehouseInvoice])
}

/// DEF-001 - a shortfall: demand the ledger recorded that no physical stock
/// covered. The balance is clamped at zero and the unfulfilled remainder is
/// recorded here, so `currentStock = ledgerNet + openDeficit` always holds and
/// the movement is never silently rewritten. Incoming stock settles this before
/// it becomes spendable.
model StockDeficit {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouseId String
  /// Always positive: the magnitude that could not be covered.
  quantity    Decimal
  /// OPEN | SETTLED_BY_CORRECTION | SETTLED_BY_RECEIPT | WRITTEN_OFF
  status      String   @default("OPEN")
  /// The movement whose issue could not be covered.
  sourceTransactionId String?
  /// The receipt that settled it, when settled by an incoming movement.
  settledByTransactionId String?
  reason      String?
  resolution  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  resolvedById String?

  @@index([itemId, status])
  @@index([status, createdAt])
  @@index([warehouseId, status])
}
