// Prisma Schema - Database Configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String   @default("[]")
  color       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  roleUsers   UserRole[]
  rolePerms   RolePermission[]
  invitations Invitation[]

  @@map("roles")
}

model User {
  id                     String           @id @default(uuid())
  username               String           @unique
  email                  String?          @unique
  passwordHash           String
  firstName              String?
  lastName               String?
  isActive               Boolean          @default(true)
  failedAttempts         Int              @default(0)
  lockoutUntil           DateTime?
  theme                  String           @default("classic")
  roleId                 String
  role                   Role             @relation(fields: [roleId], references: [id])
  updatedAt              DateTime         @updatedAt
  createdAt              DateTime         @default(now())
  createdOpeningBalances OpeningBalance[] @relation("BalanceCreator")
  
  // Phase 2: Multi-login and Email Invites
  googleId               String?          @unique
  inviteToken            String?          @unique
  inviteExpires          DateTime?
  isEmailConfirmed       Boolean          @default(false)
  userRoles              UserRole[]
  sentInvitations        Invitation[]     @relation("InvitationSender")
  acceptedInvitation     Invitation?      @relation("InvitationRecipient")
  auditLogs              AuditLog[]       @relation("AuditActor")
  activeSessions         ActiveSession[]
  idempotencyRecords     IdempotencyRecord[]
  createdPartners        Partner[]         @relation("PartnerCreator")
  createdOrders          Order[]           @relation("OrderCreator")
  createdStocktaking     StocktakingSession[] @relation("StocktakingCreator")
  stocktakingCounts      StocktakingCount[] @relation("StocktakingCounter")

  @@map("users")
}

model AuditLog {
  id             String   @id @default(cuid())
  userId         String?  @map("actorId")
  action         String   // CREATE / UPDATE / ARCHIVE / DELETE / RESTORE
  entityType     String   // Item / Transaction / User / etc.
  entityId       String
  details        String?  @map("message")
  timestamp      DateTime @default(now())
  ipAddress      String?
  metadata       String?
  actorUsername  String
  actorRole      String
  targetUserId   String?
  targetResource String?
  status         String   @default("SUCCESS")
  actor          User?    @relation("AuditActor", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([status])
  @@index([timestamp])
  @@map("audit_logs")
}

model ActiveSession {
  id                String   @id @default(uuid())
  userId            String
  tokenHash         String?  @unique
  expiresAt         DateTime
  deviceInfo        String?  @map("deviceFingerprint")
  isRevoked         Boolean  @default(false)
  username          String
  role              String
  ipAddress         String
  userAgent         String
  createdAt         DateTime @default(now())
  lastActivityAt    DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("active_sessions")
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  actorId     String
  operation   String
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@unique([actorId, operation, key])
  @@index([createdAt])
  @@map("idempotency_records")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  module      String?
  action      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  rolePerms   RolePermission[]

  @@map("permissions")
}

model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedById String?
  assignedAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Invitation {
  id             String    @id @default(uuid())
  email          String
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  status         String    @default("pending")
  roleId         String
  invitedById    String?
  recipientUserId String?  @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  role           Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy      User?     @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  recipientUser  User?     @relation("InvitationRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status])
  @@map("invitations")
}

model Item {
  id              Int              @id @default(autoincrement())
  publicId        String?          @unique
  code            String?          @unique
  codeGenerated   Boolean          @default(false)
  barcode         String?
  name            String
  unit            String?
  category        String           @default("غير مصنف")
  minLimit        Decimal          @default(0)
  maxLimit        Decimal          @default(1000)
  orderLimit      Decimal?
  packageWeight   Decimal?
  currentStock    Decimal          @default(0)
  description     String?
  imageUrl        String?
  attachments     Json?
  isArchived      Boolean          @default(false)
  archivedAt      DateTime?
  archivedBy      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       String?
  updatedBy       String?
  openingBalances OpeningBalance[]
  targetFormulas  Formulation[]    @relation("FormulationTargetItem")
  formulaRows     FormulationItem[] @relation("FormulationIngredientItem")
  transactions    Transaction[]
  orderItems      OrderItem[]
  stocktakingEntries StocktakingEntry[]
  stockDeficits     StockDeficit[]

  @@index([name])
  @@index([code])
  @@index([barcode])
  @@index([isArchived])
}

model Partner {
  id           String   @id @default(uuid())
  name         String
  type         String
  phone        String
  address      String?
  notes        String?
  createdById  String?
  createdBy    User?    @relation("PartnerCreator", fields: [createdById], references: [id], onDelete: SetNull)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([name])
  @@index([type])
  @@map("partners")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  type         String
  partnerId    String
  partner      Partner     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  warehouseId  String?
  date         DateTime
  status       String      @default("pending")
  totalAmount  Decimal?
  notes        String?
  createdById  String?
  createdBy    User?       @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([partnerId])
  @@index([warehouseId])
  @@index([status])
  @@index([date])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantity     Decimal
  unit         String?

  @@unique([orderId, itemId])
  @@index([itemId])
  @@map("order_items")
}

model StocktakingSession {
  id             String   @id @default(uuid())
  monthKey       String
  warehouseId    String   @default("default")
  status         String   @default("open")
  closedAt       DateTime?
  closedById     String?
  archivedPdfName String?
  archivedPdfMime String?
  archivedPdfData String?
  createdById    String?
  createdBy      User?    @relation("StocktakingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries        StocktakingEntry[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([monthKey, warehouseId])
  @@index([status])
  @@map("stocktaking_sessions")
}

model StocktakingEntry {
  id           String   @id @default(uuid())
  sessionId    String
  session      StocktakingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId       Int
  item         Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actualCount  Decimal?
  notes        String?
  counts       StocktakingCount[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sessionId, itemId])
  @@index([itemId])
  @@map("stocktaking_entries")
}

model StocktakingCount {
  id         String   @id @default(uuid())
  entryId    String
  entry      StocktakingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  value      Decimal
  countedById String?
  countedBy  User?    @relation("StocktakingCounter", fields: [countedById], references: [id], onDelete: SetNull)
  countedAt  DateTime @default(now())

  @@index([entryId])
  @@index([countedById])
  @@map("stocktaking_counts")
}

model Formulation {
  id                 String            @id @default(cuid())
  code               String            @unique
  name               String
  targetItemId       Int
  expectedCostPerTon Decimal?
  notes              String?
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  createdBy          String?
  updatedBy          String?
  targetItem         Item              @relation("FormulationTargetItem", fields: [targetItemId], references: [id], onDelete: Restrict)
  items              FormulationItem[]

  @@index([targetItemId])
  @@index([name])
  @@index([isActive])
  @@map("formulations")
}

model FormulationItem {
  id            String      @id @default(cuid())
  formulationId String
  itemId        Int
  percentage    Decimal
  weightPerTon  Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  formulation   Formulation @relation(fields: [formulationId], references: [id], onDelete: Cascade)
  item          Item        @relation("FormulationIngredientItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([formulationId, itemId])
  @@index([itemId])
  @@map("formulation_items")
}

model OpeningBalance {
  id            Int      @id @default(autoincrement())
  itemId        Int
  financialYear Int
  quantity      Decimal
  unitCost      Decimal?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?

  item    Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  creator User? @relation("BalanceCreator", fields: [createdBy], references: [id])

  @@unique([itemId, financialYear])
  @@index([financialYear])
}

model UnloadingRule {
  id                     String   @id @default(cuid())
  ruleName               String   @unique
  allowedDurationMinutes Int
  penaltyRatePerMinute   Decimal
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdBy              String?
  updatedBy              String?
  transactions           Transaction[]

  @@index([ruleName])
  @@index([isActive])
  @@map("unloading_rules")
}

model ReferenceDataValue {
  id        String   @id @default(uuid())
  kind      String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([kind])
  @@index([value])
  @@map("reference_data_values")
}

model Transaction {
  id                 Int      @id @default(autoincrement())
  publicId           String   @unique
  date               DateTime
  itemId             Int
  warehouseId        String?
  warehouseInvoice   String?
  supplierInvoice    String?
  type               String
  quantity           Decimal
  supplierNet        Decimal?
  difference         Decimal?
  packageCount       Decimal?
  weightSlip         String?
  salaryOfWorker     Decimal?
  supplierOrReceiver String
  truckNumber        String?
  trailerNumber      String?
  driverName         String?
  entryTime          String?
  exitTime           String?
  unloadingRuleId    String?
  unloadingDuration  Int?
  delayDuration      Int?
  delayPenalty       Decimal?
  calculatedFine     Decimal?
  notes              String?
  attachmentData     String?
  attachmentName     String?
  attachmentType     String?
  googleDriveLink    String?
  adjustmentReason           String?
  adjustmentSourceReference  String?
  adjustmentDirection        String?
  createdByUserId    String?
  timestamp          BigInt?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unloadingRule UnloadingRule? @relation(fields: [unloadingRuleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([date])
  @@index([itemId])
  @@index([type])
  @@index([unloadingRuleId])
  @@index([warehouseInvoice])
}

/// DEF-001 - a shortfall: demand the ledger recorded that no physical stock
/// covered. The balance is clamped at zero and the unfulfilled remainder is
/// recorded here, so `currentStock = ledgerNet + openDeficit` always holds and
/// the movement is never silently rewritten. Incoming stock settles this before
/// it becomes spendable.
model StockDeficit {
  id          Int      @id @default(autoincrement())
  publicId    String   @unique
  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  warehouseId String
  /// Always positive: the magnitude that could not be covered.
  quantity    Decimal
  /// OPEN | SETTLED_BY_CORRECTION | SETTLED_BY_RECEIPT | WRITTEN_OFF
  status      String   @default("OPEN")
  /// The movement whose issue could not be covered.
  sourceTransactionId String?
  /// The receipt that settled it, when settled by an incoming movement.
  settledByTransactionId String?
  reason      String?
  resolution  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  resolvedById String?

  @@index([itemId, status])
  @@index([status, createdAt])
  @@index([warehouseId, status])
}
